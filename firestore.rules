rules_version = '2';
// Security rules for Skybound online play. Paste this into Firebase console > Firestore > Rules and Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function shortText(v, max) {
      return v is string && v.size() <= max;
    }
    // The look every public record carries: avatar, frame, gold name.
    function validLook(d) {
      return shortText(d.avatar, 16) && shortText(d.frame, 16) && d.gold is bool;
    }
    function validName(n) {
      return n is string && n.size() > 0 && n.size() <= 20;
    }
    // A leaderboard entry, stamped with the server time.
    function validEntry(d) {
      return d.keys().hasOnly(['name', 'score', 'stage', 'skin', 'avatar', 'frame', 'gold', 'clan', 'at'])
        && validName(d.name)
        && d.score is int && d.score >= 0 && d.score <= 100000000
        && shortText(d.stage, 12) && shortText(d.skin, 12)
        && (!('avatar' in d) || shortText(d.avatar, 16))
        && (!('frame' in d) || shortText(d.frame, 16))
        && (!('gold' in d) || d.gold is bool)
        && (!('clan' in d) || shortText(d.clan, 5))
        && d.at == request.time;
    }
    // Everyone can read the boards; players write only their own entry, and a score never goes down.
    match /leaders/{uid} {
      allow read: if true;
      allow create: if owner(uid) && validEntry(request.resource.data);
      allow update: if owner(uid) && validEntry(request.resource.data)
        && request.resource.data.score >= resource.data.score;
    }
    match /weekly/{week}/leaders/{uid} {
      allow read: if true;
      allow create: if owner(uid) && week.matches('^[0-9]{4}-W[0-9]{2}$') && validEntry(request.resource.data);
      allow update: if owner(uid) && validEntry(request.resource.data)
        && request.resource.data.score >= resource.data.score;
    }
    // Season ranking: one entry per player per monthly season; season points never go down.
    function validSeason(d) {
      return d.keys().hasOnly(['name', 'sp', 'avatar', 'frame', 'gold', 'clan', 'at'])
        && validName(d.name)
        && d.sp is int && d.sp >= 0 && d.sp <= 10000000
        && validLook(d) && shortText(d.clan, 5)
        && d.at == request.time;
    }
    match /seasons/{season}/players/{uid} {
      allow read: if true;
      allow create: if owner(uid) && season.matches('^S[0-9]{1,4}$') && validSeason(request.resource.data);
      allow update: if owner(uid) && validSeason(request.resource.data)
        && request.resource.data.sp >= resource.data.sp;
    }
    // Cloud saves are private to their owner.
    match /players/{uid} {
      allow read: if owner(uid);
      allow write: if owner(uid)
        && request.resource.data.keys().hasOnly(['save', 'at'])
        && request.resource.data.save is string && request.resource.data.save.size() < 20000
        && request.resource.data.at == request.time;
    }
    // Public profiles: anyone can look, only the player writes.
    match /profiles/{uid} {
      allow read: if true;
      allow write: if owner(uid)
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'frame', 'gold', 'clanId', 'clanTag', 'clanName', 'best', 'skin', 'at'])
        && validName(request.resource.data.name) && validLook(request.resource.data)
        && shortText(request.resource.data.clanId, 40) && shortText(request.resource.data.clanTag, 5)
        && shortText(request.resource.data.clanName, 20) && shortText(request.resource.data.skin, 12)
        && request.resource.data.best is int && request.resource.data.best >= 0
        && request.resource.data.at == request.time;
    }

    // ---- Clans ----
    match /clans/{clanId} {
      function member(uid) {
        return exists(/databases/$(database)/documents/clans/$(clanId)/members/$(uid));
      }
      function memberAfter(uid) {
        return existsAfter(/databases/$(database)/documents/clans/$(clanId)/members/$(uid));
      }
      function roleOf(uid) {
        return get(/databases/$(database)/documents/clans/$(clanId)/members/$(uid)).data.role;
      }
      function isAdmin() {
        return signedIn() && member(request.auth.uid) && roleOf(request.auth.uid) in ['leader', 'admin'];
      }
      function clanData() {
        return get(/databases/$(database)/documents/clans/$(clanId)).data;
      }
      function isLeader() {
        return signedIn() && exists(/databases/$(database)/documents/clans/$(clanId))
          && clanData().owner == request.auth.uid;
      }
      function validSettings(d) {
        return shortText(d.desc, 120) && shortText(d.badge, 12) && shortText(d.color, 9) && d.open is bool;
      }
      function validClan(d) {
        return d.keys().hasOnly(['name', 'key', 'tag', 'desc', 'badge', 'color', 'open', 'owner', 'memberCount', 'score', 'at'])
          && d.name is string && d.name.size() >= 3 && d.name.size() <= 20 && d.key == d.name.lower()
          && d.tag is string && d.tag.matches('^[A-Z0-9]{2,5}$')
          && validSettings(d) && d.owner is string
          && d.memberCount is int && d.memberCount >= 0 && d.memberCount <= 30
          && d.score is int && d.score >= 0;
      }
      allow read: if true;
      // Creating: the creator owns it and joins as leader in the same batch.
      allow create: if signedIn() && validClan(request.resource.data)
        && request.resource.data.owner == request.auth.uid && request.resource.data.memberCount == 1
        && request.resource.data.at == request.time
        && memberAfter(request.auth.uid);
      allow update: if signedIn() && validClan(request.resource.data) && (
        // Joining, leaving, kicking or accepting moves the member count by one; trophies only go up.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'score'])
          && (request.resource.data.memberCount - resource.data.memberCount) in [-1, 0, 1]
          && request.resource.data.score >= resource.data.score
          && (member(request.auth.uid) || memberAfter(request.auth.uid)))
        // Admins and the leader edit the description, badge, colour and open setting.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['desc', 'badge', 'color', 'open']) && isAdmin())
        // The leader hands over leadership to another member (also when leaving).
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner', 'memberCount'])
          && resource.data.owner == request.auth.uid
          && member(request.resource.data.owner)
          && (request.resource.data.memberCount - resource.data.memberCount) in [-1, 0]));
      // Disbanding: only the leader, when nobody else is left.
      allow delete: if isLeader() && resource.data.memberCount <= 1;

      match /members/{uid} {
        function validMember(d) {
          return d.keys().hasOnly(['name', 'avatar', 'frame', 'gold', 'role', 'best', 'at'])
            && validName(d.name) && validLook(d)
            && d.role in ['leader', 'admin', 'member']
            && d.best is int && d.best >= 0;
        }
        allow read: if true;
        allow create: if signedIn() && validMember(request.resource.data) && (
          // The founder joins as leader while creating the clan.
          (owner(uid) && request.resource.data.role == 'leader'
            && !exists(/databases/$(database)/documents/clans/$(clanId))
            && getAfter(/databases/$(database)/documents/clans/$(clanId)).data.owner == uid)
          // Anyone can join an open clan that has room.
          || (owner(uid) && request.resource.data.role == 'member'
            && clanData().open == true && clanData().memberCount < 30)
          // Admins let in a player who asked to join.
          || (isAdmin() && request.resource.data.role == 'member'
            && exists(/databases/$(database)/documents/clans/$(clanId)/requests/$(uid))));
        allow update: if signedIn() && validMember(request.resource.data) && (
          // Players refresh their own name, look and best, but not their role.
          (owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatar', 'frame', 'gold', 'best'])
            && request.resource.data.best >= resource.data.best)
          // Only the leader changes roles; a new leader must also be the clan owner after the change.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
            && clanData().owner == request.auth.uid
            && (request.resource.data.role != 'leader'
              || getAfter(/databases/$(database)/documents/clans/$(clanId)).data.owner == uid)));
        // Leaving yourself, admins removing members, the leader removing anyone.
        allow delete: if owner(uid)
          || (isAdmin() && resource.data.role == 'member')
          || isLeader();
      }
      match /requests/{uid} {
        allow read: if true;
        allow create: if owner(uid)
          && request.resource.data.keys().hasOnly(['name', 'avatar', 'frame', 'gold', 'best', 'at'])
          && validName(request.resource.data.name) && validLook(request.resource.data)
          && request.resource.data.best is int && request.resource.data.best >= 0
          && !member(uid);
        allow delete: if owner(uid) || isAdmin();
      }
    }
  }
}
