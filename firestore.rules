rules_version = '2';
// Security rules for Skybound's online high scores. Paste this into Firebase console > Firestore > Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // A leaderboard entry: display name, score, stage and skin, stamped with the server time.
    function validEntry(d) {
      return d.keys().hasOnly(['name', 'score', 'stage', 'skin', 'at'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 20
        && d.score is int && d.score >= 0 && d.score <= 100000000
        && d.stage is string && d.stage.size() <= 12
        && d.skin is string && d.skin.size() <= 12
        && d.at == request.time;
    }
    // Everyone can read the boards; players write only their own entry, and a score never goes down.
    match /leaders/{uid} {
      allow read: if true;
      allow create: if owner(uid) && validEntry(request.resource.data);
      allow update: if owner(uid) && validEntry(request.resource.data)
        && request.resource.data.score >= resource.data.score;
    }
    match /weekly/{week}/leaders/{uid} {
      allow read: if true;
      allow create: if owner(uid) && week.matches('^[0-9]{4}-W[0-9]{2}$') && validEntry(request.resource.data);
      allow update: if owner(uid) && validEntry(request.resource.data)
        && request.resource.data.score >= resource.data.score;
    }
    // Cloud saves are private to their owner.
    match /players/{uid} {
      allow read: if owner(uid);
      allow write: if owner(uid)
        && request.resource.data.keys().hasOnly(['save', 'at'])
        && request.resource.data.save is string && request.resource.data.save.size() < 20000
        && request.resource.data.at == request.time;
    }
  }
}
